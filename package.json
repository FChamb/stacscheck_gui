{
  "name": "stacscheck-gui",
  "displayName": "stacscheck GUI",
  "description": "A VS Code extension for running and authoring stacscheck test suites",
  "version": "0.0.1",
  "publisher": "FChamb",
  "repository": {
    "type": "git",
    "url": "https://github.com/FChamb/stacscheck_gui"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:stacscheck-gui.runTests",
    "onCommand:stacscheck-gui.selectDirectory",
    "onCommand:stacscheck-gui.addTest",
    "onView:stacscheckControl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stacscheck-gui.runTests",
        "title": "stacscheck-gui: Run Tests",
        "category": "stacscheck-gui",
        "icon": "$(play)"
      },
      {
        "command": "stacscheck-gui.selectDirectory",
        "title": "Select Test Directory",
        "icon": "$(folder-opened)"
      },
      {
        "command": "stacscheck-gui.addTest",
        "title": "Add Custom stacscheck Test",
        "icon": "$(diff-added)"
      },
      {
        "command": "stacscheck-gui.setSuite",
        "title": "Set Suite"
      },
      {
        "command": "stacscheck-gui.enterTeacherMode",
        "title": "Enter Teacher Mode"
      },
      {
        "command": "stacscheck-gui.exitTeacherMode",
        "title": "Exit Teacher Mode"
      },
      {
        "command": "stacscheck-gui.startRecording",
        "title": "Start Recording"
      },
      {
        "command": "stacscheck-gui.stopRecording",
        "title": "Stop Recording"
      },
      {
        "command": "stacscheck-gui.createSuiteFromWizard",
        "title": "Create Suite From Wizard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stacscheck-explorer",
          "title": "stacscheck",
          "icon": "media/stacscheck.svg"
        }
      ]
    },
    "views": {
      "stacscheck-explorer": [
        {
          "id": "stacscheckControl",
          "name": "Control Panel",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^8.57.1",
    "typescript": "^5.9.2"
  }
}